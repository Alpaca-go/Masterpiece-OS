{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masterpiece://schemas/image-generation/image-generation-source-bundle-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePreset", "deliverable", "purpose", "userIntent"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "sourcePreset": { "enum": ["visual_analysis", "document_context", "reference_anchor", "integrated_context", "creative_intelligence"] },
    "deliverable": { "enum": ["anchor_image", "brand_poster", "packaging_render", "vi_application", "interior_scene", "storefront_scene", "free_concept"] },
    "purpose": { "enum": ["exploration", "production", "creative_anchor"] },
    "projectId": { "type": "string", "minLength": 1 },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "visualRunId": { "type": "string" },
        "selectedAssetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentRunId"],
      "properties": { "documentRunId": { "type": "string", "minLength": 1 } }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceAnchorRunId"],
      "properties": { "referenceAnchorRunId": { "type": "string", "minLength": 1 } }
    },
    "userIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "subject": { "type": "string" },
        "locationType": { "type": "string" },
        "aspectRatio": { "type": "string" }
      }
    }
  }
}
