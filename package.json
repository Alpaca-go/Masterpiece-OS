{
  "name": "masterpiece-os",
  "version": "5.0.0-rc.1",
  "private": true,
  "description": "Masterpiece OS v5：项目视觉理解、设计决策、媒介转译与受控生图交付系统",
  "type": "module",
  "workspaces": [
      "apps/*",
      "packages/*",
      "labs/*"
    ],
    "// archived-workspace-packages": "Packages listed below are kept in the workspaces array but have no active runtime consumer as of 2026-08-25 audit. See each package's ARCHIVED.md for the audit trail. Do not remove from workspaces without a recorded decision.",
    "// archived-workspace-packages-list": [
      "@masterpiece/model-benchmark",
      "@masterpiece/creative-production-runtime",
      "@masterpiece/image-provider-dashscope"
    ],
    "scripts": {
    "analyze": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "inventory": "node ./apps/cli/bin/masterpiece-os.js inventory",
    "cli:dev": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "cli:test": "cd apps/cli && node --test tests/*.test.js tests/analysis-engine/*.test.js",
    "sync:version": "node ./scripts/sync-product-version.mjs",
    "verify:version-consistency": "node ./scripts/verify-version-consistency.mjs",
    "verify:version-naming": "node ./scripts/verify-version-naming.mjs",
    "verify:workspace-boundaries": "node ./scripts/verify-workspace-boundaries.mjs",
    "test": "node --test tests/*.test.js tests/packages/*/*.test.js tests/image-generation/*.test.js tests/packages/creative-intelligence/ci-w1b/*.test.js tests/packages/creative-intelligence/ci-w1b.1/*.test.js tests/packages/creative-intelligence/ci-w1b.2/*.test.js tests/packages/creative-intelligence/ci-w2/*.test.js tests/packages/creative-intelligence/ci-7.4/*.test.js tests/packages/creative-intelligence/ci-7.4-r1/*.test.js tests/packages/creative-intelligence/ci-7.4-r2/*.test.js tests/packages/creative-intelligence/ci-7.4-r2.1/*.test.js tests/packages/creative-intelligence/ci-7.5-r1/*.test.js",
    "golden:test": "node ./scripts/golden/run-golden.mjs",
    "test:image-generation": "node --test tests/image-generation/*.test.js",
    "test:space-route-integrity": "node --test tests/image-generation/space-route-integrity.test.js",
    "test:space-semantic-gate": "node --test tests/image-generation/space-spatial-semantic-gate.test.js",
    "test:packages": "node --test tests/packages/*/*.test.js",
    "runtime-application:test": "tsx --test tests/runtime-application/*.test.ts",
    "runtime:test": "node --test tests/packages/runtime-core/*.test.js && npm run runtime-application:test",
    "web-runtime:test": "tsx --test apps/web-runtime/tests/*.test.ts",
    "web-runtime:typecheck": "tsc --noEmit -p apps/web-runtime/tsconfig.json",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:build": "npm --prefix apps/web run build",
    "verify:current-flows": "node ./scripts/verify-current-flows.mjs",
    "verify:no-project-specific-production-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:no-project-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:golden-boundary": "node ./scripts/verify-golden-production-boundary.mjs",
    "verify:production-boundaries": "node ./scripts/verify-production-boundaries.mjs",
    "verify:no-obsolete-code": "node ./scripts/verify-no-obsolete-code.mjs",
    "verify:tracked-runtime-assets": "node ./scripts/verify-tracked-runtime-assets.mjs",
    "verify:repository-contract": "node ./scripts/verify-repository-contract.mjs",
    "verify:g01-frozen-baseline": "node ./scripts/verify-g01-frozen-baseline.mjs",
    "verify:g02-source-readiness": "node ./scripts/verify-g02-source-readiness.mjs",
    "verify:g02-prelive-readiness": "node ./scripts/verify-g02-prelive-readiness.mjs",
    "verify:g02-live-authorization": "node ./scripts/verify-g02-live-authorization.mjs",
    "verify:g02-attempt-1": "node ./scripts/verify-g02-attempt-1.mjs",
    "verify:a4-default-authority": "node ./scripts/verify-a4-default-authority.mjs",
    "verify:a4-frozen-prompt": "node ./scripts/verify-a4-frozen-prompt.mjs",
    "verify:a4-version-namespace": "node ./scripts/verify-a4-version-namespace.mjs",
    "verify:a4-legacy-desktop": "node ./scripts/verify-a4-legacy-desktop.mjs",
    "verify:a4-golden-mutation": "node ./scripts/verify-a4-golden-mutation.mjs",
    "verify:a4-secret-safety": "node ./scripts/verify-a4-secret-safety.mjs",
    "verify:a4": "npm run verify:a4-default-authority && npm run verify:a4-frozen-prompt && npm run verify:a4-version-namespace && npm run verify:a4-legacy-desktop && npm run verify:a4-golden-mutation && npm run verify:a4-secret-safety",
    "repo:guard:test": "node --test tests/repository-contract-guard.test.js tests/version-naming-guard.test.js tests/archive-boundary.test.js tests/runtime-boundary.test.js tests/web-runtime-host-boundary.test.js tests/packages/runtime-core/operation-registry.test.js tests/a4-anti-regression-guards.test.js",
    "repo:verify": "npm run verify:repository-contract && npm run verify:version-consistency && npm run verify:version-naming && npm run verify:workspace-boundaries && npm run verify:no-obsolete-code && npm run verify:production-boundaries && npm run verify:tracked-runtime-assets && npm run verify:no-project-specific-production-rules && npm run verify:golden-boundary && npm run verify:current-flows && npm run verify:a4 && npm run repo:guard:test",
    "repo:check": "npm run repo:verify && npm test && npm run cli:test && npm run runtime:test && npm run web:smoke && npm run golden:test",
    "verify:space-compiler-baseline": "node ./scripts/verify-space-compiler-baseline.mjs",
    "verify:space-r8.6-golden-boundary": "node ./scripts/verify-space-r8.6-golden-boundary.mjs",
    "test:evaluation": "node ./scripts/run-golden-evaluation.mjs",
    "test:hidden-cases": "node ./scripts/run-hidden-cases.mjs",
    "lab:document-directions": "node ./labs/document-visual-directions/bin/run.mjs",
    "lab:document-directions:test": "node --test labs/document-visual-directions/tests/*.test.js",
    "lab:reference-conversion": "node ./labs/reference-style-conversion/bin/run.mjs",
    "lab:reference-conversion:test": "node --test labs/reference-style-conversion/tests/*.test.js",
    "visual-analysis:probe-volcengine": "node ./scripts/visual-analysis-probe-volcengine.mjs",
    "a2-d:run": "node ./scripts/a2-d-run-evaluations.mjs",
    "a2-f:llm-judge": "node ./scripts/a2-f-llm-judge.mjs",
    "web:dev": "npm --prefix apps/web-runtime run dev",
    "web:smoke": "npm --prefix apps/web-runtime run smoke",
    "test:space-dna": "node space-generator/v1-experimental/field-schema/tests/validate.test.mjs",
    "test:space-dna-trace": "node space-generator/v1-experimental/prompt-compiler/trace/tests/compile-trace.test.mjs",
    "test:space-dna-vertical": "node space-generator/v1-experimental/test-cases/jiuzhou-aesthetics/tests/vertical.test.mjs",
    "space-dna-vertical:run": "node space-generator/v1-experimental/test-cases/jiuzhou-aesthetics/run.mjs",
    "test:space-dna-prompt": "node space-generator/v1-experimental/prompt-compiler/field-enriched/tests/compile-prompt.test.mjs",
    "test:space-dna-prompt-v11": "node space-generator/v1-experimental/prompt-compiler/field-enriched/tests/compile-prompt-v1.1.test.mjs",
    "test:space-evaluation": "node space-generator/v1-experimental/evaluation/tests/evaluate-space.test.mjs",
    "test:space-anchor-aware": "node space-generator/v1-experimental/prompt-compiler/anchor-aware/tests/compile-with-anchor.test.mjs",
    "test:space-dna-variation": "node space-generator/v1-experimental/prompt-compiler/variation/tests/derive-variants.test.mjs",
    "test:space-dna-regression": "node space-generator/v1-experimental/test-cases/regression/tests/regression.test.mjs",
    "test:space-architecture-function-bridge": "node space-generator/v1-experimental/prompt-compiler/field-enriched/tests/architecture-function-bridge.test.mjs",
    "test:space-function-calibrations": "node space-generator/v1-experimental/function-calibrations/tests/function-calibrations.test.mjs",
    "test:space-architecture-bridge": "node space-generator/v1-experimental/architecture-bridge/tests/compile-architecture-bridge.test.mjs",
    "test:space-spatial-intelligence-pipeline": "node space-generator/v1-experimental/spatial-intelligence-pipeline/tests/compile-spatial-intelligence-prompt.test.mjs",
    "test:space-spatial-reality": "node space-generator/v1-experimental/spatial-reality/tests/compile-spatial-reality-prompt.test.mjs",
    "test:space-architecture-preservation": "node space-generator/v1-experimental/architecture-preservation/tests/compile-architecture-preservation-prompt.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "keywords": [
    "design",
    "brand",
    "creative-brief",
    "creative-reasoning"
  ],
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0"
  }
}

