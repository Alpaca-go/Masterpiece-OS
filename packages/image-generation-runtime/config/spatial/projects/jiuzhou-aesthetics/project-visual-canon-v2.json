  "projectPalette": {
    "base": ["pearl_white", "warm_white", "light_gray"],
    "accent": ["mineral_lavender", "mist_purple"],
    "text": ["graphite_black"],
    "metal": ["silver_gray"],
    "iridescence": "controlled"
  },
  "signatureMotifs": [
