{
  "name": "@masterpiece/image-generation-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic image-generation runtime: context snapshot, reference selector, prompt compiler, three-layer gates, dry-run. No model calls in the compiler, no Electron.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*",
    "./reference-selector": "./src/reference-selector.js",
    "./prompt-compiler": "./src/prompt-compiler.js",
    "./gates": "./src/gates.js",
    "./context-snapshot": "./src/context-snapshot.js",
    "./task-builder": "./src/task-builder.js",
    "./pipeline-mode": "./src/pipeline-mode.js",
    "./generation": "./src/generation/index.js",
    "./space": "./src/space/index.js",
    "./space/index.js": "./src/space/index.js",
    "./prompt-templates": "./src/prompt-templates/deliverable-template-system.js",
    "./prompt-template-compiler": "./src/prompt-templates/prompt-template-compiler.js",
    "./creative-director": "./src/creative-director/index.js",
    "./reference-plan": "./src/reference-plan/index.js"
  }
}
