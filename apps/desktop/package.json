{
  "name": "masterpiece-os-desktop",
  "version": "5.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Masterpiece OS Desktop — multimodal API client",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web:dev": "node scripts/run-web-dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:real-provider": "node scripts/run-real-provider-smoke.mjs",
    "smoke:web": "node scripts/run-web-primary-smoke.mjs",
    "smoke:creative-direction": "node scripts/run-real-provider-v18-1-smoke.mjs",
    "smoke:visual-upgrade": "node scripts/run-real-provider-v18-1-smoke.mjs",
    "smoke:visual-decision": "node scripts/run-real-provider-visual-decision-smoke.mjs",
    "space-gen:test-real": "node scripts/run-space-generator-real-test.mjs",
    "space-gen:ab-test": "node scripts/run-space-generator-ab-test.mjs",
    "smoke:golden-control": "node scripts/run-real-provider-golden-control-smoke.mjs",
    "smoke:production-stability": "node scripts/run-real-provider-production-stability-smoke.mjs",
    "smoke:logo-post-composite": "node scripts/run-real-provider-logo-post-composite-smoke.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "prepackage:portable": "npm --prefix ../.. run verify:current-flows",
    "package:portable": "npm run build && node scripts/package-win.mjs",
    "package:win": "npm run package:portable"
  },
  "dependencies": {
    "@masterpiece/analysis-runtime": "file:../packages/analysis-runtime",
    "@masterpiece/creative-production-runtime": "file:../packages/creative-production-runtime",
    "@masterpiece/document-ingestion": "file:../packages/document-ingestion",
    "@masterpiece/image-generation-adapter": "file:../packages/image-generation-adapter",
    "@masterpiece/image-generation-contracts": "file:../packages/image-generation-contracts",
    "@masterpiece/image-generation-runtime": "file:../packages/image-generation-runtime",
    "@masterpiece/image-provider-dashscope": "file:../packages/image-provider-dashscope",
    "@masterpiece/model-benchmark": "file:../packages/model-benchmark",
    "@masterpiece/model-registry": "file:../packages/model-registry",
    "@masterpiece/model-runtime": "file:../packages/model-runtime",
    "@masterpiece/project-contracts": "file:../packages/project-contracts",
    "@masterpiece/reference-asset-inspector": "file:../packages/reference-asset-inspector",
    "@masterpiece/runtime-core": "file:../packages/runtime-core",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
