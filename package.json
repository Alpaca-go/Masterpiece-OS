{
  "name": "masterpiece-os",
  "version": "5.0.0-rc.1",
  "private": true,
  "description": "Masterpiece OS v5：项目视觉理解、设计决策、媒介转译与受控生图交付系统",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "labs/*"
  ],
  "scripts": {
    "analyze": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "inventory": "node ./apps/cli/bin/masterpiece-os.js inventory",
    "cli:dev": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "cli:test": "cd apps/cli && node --test tests/*.test.js tests/analysis-engine/*.test.js",
    "sync:version": "node ./scripts/sync-product-version.mjs",
    "verify:version-consistency": "node ./scripts/verify-version-consistency.mjs",
    "verify:version-naming": "node ./scripts/verify-version-naming.mjs",
    "verify:workspace-boundaries": "node ./scripts/verify-workspace-boundaries.mjs",
    "test": "node --test tests/*.test.js tests/packages/*/*.test.js tests/image-generation/*.test.js tests/packages/creative-intelligence/current/*.test.js",
    "golden:test": "node ./scripts/golden/run-golden.mjs",
    "test:image-generation": "node --test tests/image-generation/*.test.js",
    "test:space-route-integrity": "node --test tests/image-generation/space-route-integrity.test.js",
    "test:space-semantic-gate": "node --test tests/image-generation/space-spatial-semantic-gate.test.js",
    "test:packages": "node --test tests/packages/*/*.test.js",
    "runtime-application:test": "tsx --test tests/runtime-application/*.test.ts",
    "runtime:test": "node --test tests/packages/runtime-core/*.test.js && npm run runtime-application:test",
    "web-runtime:test": "tsx --test apps/web-runtime/tests/*.test.ts",
    "web-runtime:typecheck": "tsc --noEmit -p apps/web-runtime/tsconfig.json",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:build": "npm --prefix apps/web run build",
    "verify:current-flows": "node ./scripts/verify-current-flows.mjs",
    "verify:no-project-specific-production-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:no-project-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:golden-boundary": "node ./scripts/verify-golden-production-boundary.mjs",
    "verify:production-boundaries": "node ./scripts/verify-production-boundaries.mjs",
    "verify:no-obsolete-code": "node ./scripts/verify-no-obsolete-code.mjs",
    "verify:tracked-runtime-assets": "node ./scripts/verify-tracked-runtime-assets.mjs",
    "verify:repository-contract": "node ./scripts/verify-repository-contract.mjs",
    "verify:analysis-provider-authority": "node ./scripts/verify-analysis-provider-authority.mjs",
    "verify:analysis-prompt-integrity": "node ./scripts/verify-analysis-prompt-integrity.mjs",
    "verify:analysis-namespace": "node ./scripts/verify-analysis-namespace.mjs",
    "verify:runtime-isolation": "node ./scripts/verify-runtime-isolation.mjs",
    "verify:analysis-golden-integrity": "node ./scripts/verify-analysis-golden-integrity.mjs",
    "verify:secret-safety": "node ./scripts/verify-secret-safety.mjs",
    "verify:analysis-guards": "npm run verify:analysis-provider-authority && npm run verify:analysis-prompt-integrity && npm run verify:analysis-namespace && npm run verify:runtime-isolation && npm run verify:analysis-golden-integrity && npm run verify:secret-safety",
    "repo:guard:test": "node --test tests/repository-contract-guard.test.js tests/version-naming-guard.test.js tests/archive-boundary.test.js tests/runtime-boundary.test.js tests/web-runtime-host-boundary.test.js tests/packages/runtime-core/operation-registry.test.js tests/analysis-release-guards.test.js",
    "repo:verify": "npm run verify:repository-contract && npm run verify:version-consistency && npm run verify:version-naming && npm run verify:workspace-boundaries && npm run verify:no-obsolete-code && npm run verify:production-boundaries && npm run verify:tracked-runtime-assets && npm run verify:no-project-specific-production-rules && npm run verify:golden-boundary && npm run verify:current-flows && npm run verify:analysis-guards && npm run repo:guard:test",
    "repo:check": "npm run repo:verify && npm test && npm run cli:test && npm run runtime:test && npm run web:smoke && npm run golden:test",
    "verify:space-golden-boundary": "node ./scripts/verify-space-golden-boundary.mjs",
    "test:evaluation": "node ./scripts/run-golden-evaluation.mjs",
    "test:hidden-cases": "node ./scripts/run-hidden-cases.mjs",
    "lab:reference-conversion": "node ./labs/reference-style-conversion/bin/run.mjs",
    "lab:reference-conversion:test": "node --test labs/reference-style-conversion/tests/*.test.js",
    "visual-analysis:probe-volcengine": "node ./scripts/visual-analysis-probe-volcengine.mjs",
    "creative-research:smoke-baidu": "tsx ./scripts/creative-research-baidu-smoke.ts",
    "web:dev": "npm --prefix apps/web-runtime run dev",
    "web:smoke": "npm --prefix apps/web-runtime run smoke"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "keywords": [
    "design",
    "brand",
    "creative-brief",
    "creative-reasoning"
  ],
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
