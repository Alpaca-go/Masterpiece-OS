  "loaders": {
    "fieldMechanismsOnly": "loader/load-anchors.mjs :: loadArchitectureAnchors(brandKey) returns mechanism strings, no image bytes",
    "inContextReference": "loader/load-anchors.mjs :: loadAnchorsAsInContextReference(brandKey) returns compact list with image path (for runtime use, not for prompt text)",
    "automaticSelection": "loader/load-anchors.mjs :: selectAnchors(brandKey, criteria) Phase 8C: scores anchors by industry / sceneType / commercialContext / functional realism, returns top-K"
  },
  "selectionPolicy": {
    "scoringWeights": {
      "industryMatch": 0.35,
      "sceneTypeMatch": 0.3,
      "commercialContextMatch": 0.15,
      "functionalAlignment": 0.1,
      "weight": 0.1
    },
    "minScore": 0,
    "defaultMaxCount": 3,
    "phase8DMultibrandGuard": "Phase 8D §3 Risk 1: selectAnchors industry match 防护 JZMX overfit. JZMX anchors.applicability.industries 收紧到 ['medical_aesthetics'] 不再 cross-industry. FTT / YJLF 各自独立. industry match 权重 0.35 是 phase 8D 防 overfit 的主防线."
  },
  "inContextPolicy": {
    "maxReferencesPerPrompt": 3,
    "preferredOrder": "by role coverage: exterior -> interior_reception -> consultation_floor -> corridor -> vip_lounge -> product_display -> treatment -> lobby",
    "fallbackBehavior": "if a brand has no anchors, return empty list; prompt compiler degrades to v1.1 + Phase 8B.1 baseline (11 blocks, no architecture_context block)"
  }
