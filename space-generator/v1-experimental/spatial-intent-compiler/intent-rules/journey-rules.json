{
  "schemaVersion": "1.0",
  "description": "Phase 9A.2 §8 Rule Engine. journey-rules: userJourney 关键词 -> functionRelationship / constraints. 规则只提供方向, 不直接生成视觉.",
  "phase": "9A.2",
  "rules": [
    {
      "id": "journey-trust-formation",
      "matchKeywords": ["陌生进入", "了解专业", "建立信赖", "建立长期信赖", "信任建立"],
      "functionRelationship": [
        "入口区域: 需要可见性但不侵入 (透明边界)",
        "接待区域: 需要 staff 立即可见但不打扰",
        "专业区域: 需要渐进式私密性, 不出现硬门"
      ],
      "constraints": [
        "avoid lock-and-key doors",
        "avoid exhibition-only spaces"
      ]
    },
    {
      "id": "journey-community-dining",
      "matchKeywords": ["街边路过", "推门进来", "看见厨师", "看见操作", "路过", "热气腾腾", "产生预期"],
      "functionRelationship": [
        "门口: 客人能直接看到 production 区域 (开放厨房)",
        "等位: 客人能看到菜单或菜, 不是空的",
        "落座: 客人与 staff 之间有自然接触"
      ],
      "constraints": [
        "avoid hidden kitchen",
        "avoid menu-only ordering without visual food"
      ]
    },
    {
      "id": "journey-consultation-care",
      "matchKeywords": ["带病气", "推门进入", "纸窗", "茶角", "咨询桌", "被当作人", "被理解", "调理方案"],
      "functionRelationship": [
        "入口: 慢节奏过渡, 眼睛先慢下来",
        "等候: 有 herbal display 或茶, 不是空的",
        "咨询: 桌 + 椅 + 1-2 件办公用品, 不是纯装置"
      ],
      "constraints": [
        "avoid medical clinical",
        "avoid spa atmosphere",
        "avoid modern museum cold"
      ]
    },
    {
      "id": "journey-default-fallback",
      "matchKeywords": [],
      "matchAny": true,
      "functionRelationship": [
        "入口 -> 主区域 -> 出口: 动线主轴清晰",
        "等候区域必须有可坐家具, 不是空墙"
      ],
      "constraints": [
        "avoid unusable waiting areas"
      ]
    }
  ]
}
