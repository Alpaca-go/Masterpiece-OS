{
  "name": "masterpiece-os",
  "version": "5.0.0-rc.1",
  "private": true,
  "description": "Masterpiece OS v5：项目视觉理解、设计决策、媒介转译与受控生图交付系统",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "labs/*"
  ],
  "scripts": {
    "analyze": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "inventory": "node ./apps/cli/bin/masterpiece-os.js inventory",
    "cli:dev": "node ./apps/cli/bin/masterpiece-os.js analyze",
    "cli:test": "cd apps/cli && node --test tests/*.test.js tests/v5/*.test.js",
    "sync:version": "node ./scripts/sync-product-version.mjs",
    "verify:version-consistency": "node ./scripts/verify-version-consistency.mjs",
    "verify:workspace-boundaries": "node ./scripts/verify-workspace-boundaries.mjs",
    "test": "node --test tests/*.test.js tests/packages/*/*.test.js tests/image-generation/*.test.js",
    "test:image-generation": "node --test tests/image-generation/*.test.js",
    "test:packages": "node --test tests/packages/*/*.test.js",
    "verify:current-flows": "node ./scripts/verify-current-flows.mjs",
    "verify:no-project-specific-production-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:no-project-rules": "node ./scripts/verify-no-project-specific-production-rules.mjs",
    "verify:golden-boundary": "node ./scripts/verify-golden-production-boundary.mjs",
    "verify:production-boundaries": "node ./scripts/verify-production-boundaries.mjs",
    "verify:no-obsolete-code": "node ./scripts/verify-no-obsolete-code.mjs",
    "test:evaluation": "node ./scripts/run-golden-evaluation.mjs",
    "test:hidden-cases": "node ./scripts/run-hidden-cases.mjs",
    "lab:document-directions": "node ./labs/document-visual-directions/bin/run.mjs",
    "lab:document-directions:test": "node --test labs/document-visual-directions/tests/*.test.js",
    "lab:reference-conversion": "node ./labs/reference-style-conversion/bin/run.mjs",
    "lab:reference-conversion:test": "node --test labs/reference-style-conversion/tests/*.test.js",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "web:dev": "npm --prefix apps/desktop run web:dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:test": "npm --prefix apps/desktop test",
    "desktop:package": "npm --prefix apps/desktop run package:portable",
    "test:space-dna": "node space-generator/v1-experimental/field-schema/tests/validate.test.mjs",
    "test:space-dna-trace": "node space-generator/v1-experimental/prompt-compiler/trace/tests/compile-trace.test.mjs",
    "test:space-dna-vertical": "node space-generator/v1-experimental/test-cases/jiuzhou-aesthetics/tests/vertical.test.mjs",
    "space-dna-vertical:run": "node space-generator/v1-experimental/test-cases/jiuzhou-aesthetics/run.mjs",
    "test:space-dna-prompt": "node space-generator/v1-experimental/prompt-compiler/field-enriched/tests/compile-prompt.test.mjs",
    "test:space-dna-prompt-v11": "node space-generator/v1-experimental/prompt-compiler/field-enriched/tests/compile-prompt-v1.1.test.mjs",
    "test:space-evaluation": "node space-generator/v1-experimental/evaluation/tests/evaluate-space.test.mjs",
    "test:space-dna-variation": "node space-generator/v1-experimental/prompt-compiler/variation/tests/derive-variants.test.mjs",
    "test:space-dna-regression": "node space-generator/v1-experimental/test-cases/regression/tests/regression.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "MIT",
  "keywords": [
    "design",
    "brand",
    "creative-brief",
    "creative-reasoning"
  ],
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
